{
  "entities": {
    "Ticket": {
      "title": "Corporate Helpdesk Ticket",
      "description": "IT support ticket or P0 security escalation filed via Hyra Employee Desk or Ops Dashboard.",
      "type": "object",
      "properties": {
        "ticketCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 24,
          "pattern": "^[A-Z0-9\\-]+$",
          "description": "Human-readable corporate ticket identifier such as HYR-4092."
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 140,
          "description": "Concise issue headline."
        },
        "summary": {
          "type": "string",
          "minLength": 5,
          "maxLength": 1200,
          "description": "Detailed incident description or employee transcript summary."
        },
        "category": {
          "type": "string",
          "enum": ["Security", "IT Access", "Hardware", "Payroll", "Facilities"],
          "description": "Departmental routing category."
        },
        "priority": {
          "type": "string",
          "enum": ["P0", "P1", "P2", "P3"],
          "description": "Operational severity level; P0 triggers security escalation."
        },
        "status": {
          "type": "string",
          "enum": ["open", "in_progress", "escalated", "resolved"],
          "description": "Lifecycle status of the ticket."
        },
        "employeeName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Display name of reporting employee."
        },
        "department": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "description": "Employee business unit."
        },
        "source": {
          "type": "string",
          "enum": ["voice", "chat", "manual"],
          "description": "Intake channel."
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the creator."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "ticketCode",
        "title",
        "summary",
        "category",
        "priority",
        "status",
        "employeeName",
        "department",
        "source",
        "ownerUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "WorkplaceRequest": {
      "title": "Workplace Approval Request",
      "description": "WFH, PTO, hardware provisioning, or travel approval request.",
      "type": "object",
      "properties": {
        "requestCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 24,
          "pattern": "^[A-Z0-9\\-]+$",
          "description": "Human-readable request code such as REQ-2041."
        },
        "type": {
          "type": "string",
          "enum": ["WFH", "PTO", "Equipment", "Travel", "Access"],
          "description": "Type of workplace request."
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 140,
          "description": "Short request title."
        },
        "reason": {
          "type": "string",
          "minLength": 5,
          "maxLength": 1000,
          "description": "Business rationale or context."
        },
        "dateRange": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Target dates or duration."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "declined"],
          "description": "Approval workflow status."
        },
        "employeeName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Requester display name."
        },
        "department": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "description": "Requester department."
        },
        "reviewerNote": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500,
          "description": "Optional note from Ops approver."
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of requester."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "requestCode",
        "type",
        "title",
        "reason",
        "dateRange",
        "status",
        "employeeName",
        "department",
        "ownerUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminUser": {
      "title": "Ops Admin Marker",
      "description": "Trusted database document granting Ops Dashboard administrative privileges.",
      "type": "object",
      "properties": {
        "grantedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["grantedAt"]
    }
  },
  "firestore": {
    "/tickets/{ticketId}": {
      "schema": { "$ref": "#/entities/Ticket" },
      "description": "Real-time IT support tickets and P0 security escalations."
    },
    "/requests/{requestId}": {
      "schema": { "$ref": "#/entities/WorkplaceRequest" },
      "description": "Real-time WFH, PTO, and equipment approval requests."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Trusted Ops admin membership lookup table."
    }
  }
}
